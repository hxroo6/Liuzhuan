<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台读剪贴板权限（Android 10+ 官方 signature|privileged 权限）。
         声明后需 root 授予（pm grant 或改 packages.xml），App 才能在后台通过
         ClipboardManager.getPrimaryClip() 读到剪贴板，绕开焦点限制。
         标准版未授予时此声明无害（系统不授予，行为不变）。 -->
    <uses-permission android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Liuzhuan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 分享菜单入口：任意 App 分享文字/文件 → 流转 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 文本选择菜单入口：任意 App 选中文本 → 菜单「流转」直接发送（绕过剪贴板焦点限制） -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 剪贴板监控无障碍服务（决策 #3） -->
        <service
            android:name=".clipboard.ClipMonitorService"
            android:exported="false"
            android:label="@string/clip_monitor_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 前台服务保活（后台连接常驻） -->
        <service
            android:name=".ForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- LSPosed 剪贴板写入 hook 的广播接收器（接收 ClipHook 截获的第三方复制内容） -->
        <receiver
            android:name=".ClipReceiver"
            android:exported="true" />

        <!-- LSPosed 模块声明（标准版也声明，未激活 LSPosed 时 hook 类不会被加载，无副作用） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="流转剪贴板监听（hook 写入路径，后台复制秒达电脑）" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
    </application>
</manifest>
