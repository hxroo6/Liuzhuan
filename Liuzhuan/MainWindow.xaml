<Window x:Class="Liuzhuan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Liuzhuan.Models"
        Title="流转"
        Width="380"
        Height="680"
        WindowStyle="None"
        AllowsTransparency="False"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Background="{StaticResource PanelBrush}"
        FontFamily="{StaticResource UIFont}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 素材卡片模板（网格用：图片/视频/其他文件）— 自适应比例，紧凑排列 -->
        <DataTemplate x:Key="GridCardTemplate" DataType="{x:Type models:MaterialItem}">
            <Border x:Name="CardBorder" Margin="2" Background="{StaticResource PanelLightBrush}"
                    CornerRadius="8" MouseMove="Card_MouseMove"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    Cursor="Hand"
                    Width="154">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="132"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 📄占位符 -->
                    <TextBlock Grid.Row="0"
                               Text="📄" FontSize="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ThumbnailPath, Converter={StaticResource EmptyToVisibleConverter}}"/>
                    <!-- 缩略图区域 -->
                    <Image Grid.Row="0"
                           x:Name="ThumbImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="2"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding ThumbnailSource, NotifyOnTargetUpdated=True}"
                           TargetUpdated="ThumbnailImage_TargetUpdated"/>
                    <!-- 视频标记 -->
                    <Border Grid.Row="0"
                            Visibility="{Binding Type, Converter={StaticResource VideoVisibilityConverter}}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="3" Background="#80000000" CornerRadius="2" Padding="2,1">
                        <TextBlock Text="▶" FontSize="7" Foreground="White"/>
                    </Border>

                    <!-- 收藏星星按钮（右下角，hover或已收藏时显示） -->
                    <Button Grid.Row="0"
                            x:Name="FavStar"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="3,3,13,3" Width="20" Height="20"
                            Click="FavoriteBtn_Click"
                            Cursor="Hand"
                            Tag="{Binding Id}" ToolTip="收藏 / 取消收藏" AutomationProperties.Name="收藏 / 取消收藏"
                            Opacity="0.45">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#60000000" CornerRadius="10">
                                    <TextBlock x:Name="star" Text="☆" FontSize="12"
                                               Foreground="#CCCCCC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="star" Property="Text" Value="★"/>
                                        <Setter TargetName="star" Property="Foreground" Value="#FFD700"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#AA000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2" Background="#DD193A35" CornerRadius="4">
                        <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <!-- 文件名 -->
                                        <StackPanel Grid.Row="1" Margin="8,5,8,8">
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DetailLabel}" Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- hover时显示星星，已收藏时始终显示 -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="FavStar" Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="FavStar" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 文字卡片模板（自动换行填满卡片） -->
        <DataTemplate x:Key="TextCardTemplate" DataType="{x:Type models:MaterialItem}">
            <Border x:Name="TextCardBorder" Margin="2" Background="{StaticResource PanelLightBrush}"
                    CornerRadius="8" MouseMove="Card_MouseMove"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    Cursor="Hand"
                    MinHeight="132"
                    MaxHeight="164"
                    HorizontalAlignment="Stretch">
                <Grid>                    <TextBlock Text="灵感摘录" Foreground="{StaticResource WarmBrush}" FontSize="10" Margin="10,10,0,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding DetailLabel}" Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="10,0,30,10" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding TextContent}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"
                               Margin="10,30,10,38"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 收藏星星按钮（右下角） -->
                    <Button x:Name="TextFavStar"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="2,3,12,3" Width="20" Height="20"
                            Click="FavoriteBtn_Click"
                            Cursor="Hand"
                            Tag="{Binding Id}" ToolTip="收藏 / 取消收藏" AutomationProperties.Name="收藏 / 取消收藏"
                            Opacity="0.45">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#60000000" CornerRadius="10">
                                    <TextBlock x:Name="star" Text="☆" FontSize="12"
                                               Foreground="#CCCCCC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="star" Property="Text" Value="★"/>
                                        <Setter TargetName="star" Property="Foreground" Value="#FFD700"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#AA000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="TextFavStar" Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger SourceName="TextCardBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TextFavStar" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 列表行模板（音频用） -->
        <DataTemplate x:Key="ListRowTemplate" DataType="{x:Type models:MaterialItem}">
            <Border Background="Transparent"
                    MouseMove="Card_MouseMove"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    Cursor="Hand"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               FontSize="14" Margin="0,0,8,0"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding Type, Converter={StaticResource TypeIconConverter}}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FilePath, Converter={StaticResource PathShortConverter}}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="12"
                               Text="{Binding Duration, Converter={StaticResource DurationConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 主容器：触发条 + 面板 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PanelColumn" Width="372"/>
            <ColumnDefinition x:Name="TriggerColumn" Width="8"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 主面板 ============ -->
        <Border x:Name="MainPanel"
                Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="16,0,0,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                Margin="0,0,-1,0"
                AllowDrop="True"
                Drop="Window_Drop"
                DragEnter="Window_DragEnter"
                DragOver="Window_DragOver"
                DragLeave="Window_DragLeave"
                RenderTransformOrigin="0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题只负责窗口操作；搜索、分类与主要动作独立分层。 -->
                <Grid Grid.Row="0" Margin="16,12,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="46"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" x:Name="HeaderDragArea" Background="Transparent">
                        <Button DockPanel.Dock="Right" x:Name="CollapseBtn" Content="›" FontSize="24" Width="32" Height="32" Style="{StaticResource IconButtonStyle}" Click="CollapseBtn_Click" ToolTip="收起面板" AutomationProperties.Name="收起面板"/>
                        <Button DockPanel.Dock="Right" x:Name="SettingsBtn" Width="32" Height="32" Style="{StaticResource IconButtonStyle}" Click="SettingsBtn_Click" ToolTip="设置与设备" AutomationProperties.Name="设置与设备">
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 4,2 L 4,7 M 4,12 L 4,20 M 10,2 L 10,12 M 10,17 L 10,20 M 16,2 L 16,4 M 16,9 L 16,20 M 1,7 L 7,7 L 7,12 L 1,12 Z M 7,12 L 13,12 L 13,17 L 7,17 Z M 13,4 L 19,4 L 19,9 L 13,9 Z"/>
                        </Button>
                        <Button DockPanel.Dock="Right" x:Name="PinBtn" Content="固定" FontSize="12" Width="44" Height="32" Style="{StaticResource IconButtonStyle}" Click="PinBtn_Click" ToolTip="固定展开，鼠标移开也不收起"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="12" Margin="0,0,10,0" Background="#28524A">
                                <Path Data="M 8,13 L 27,13 M 22,8 L 27,13 L 22,18 M 27,24 L 8,24 M 13,19 L 8,24 L 13,29" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="流转" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="素材随行 · 灵感不停" FontSize="10" Foreground="{StaticResource WarmBrush}"/></StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource PanelLightBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="13" Padding="10,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" AutomationProperties.Name="搜索当前分类素材"/>
                            <TextBlock x:Name="SearchHint" Text="搜索当前分类…  Ctrl+F" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Button Grid.Column="1" x:Name="SearchClearBtn" Content="×" Style="{StaticResource IconButtonStyle}" Click="SearchClearBtn_Click" ToolTip="清除搜索" AutomationProperties.Name="清除搜索" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="＋ 添加文件" Padding="10,4" Style="{StaticResource ActionButtonStyle}" Click="AddFilesBtn_Click"/>
                        <Button DockPanel.Dock="Right" Content="粘贴" Margin="0,0,6,0" Padding="10,4" Style="{StaticResource ActionButtonStyle}" Click="PasteBtn_Click" ToolTip="从剪贴板添加素材 · Ctrl+V"/>
                        <TextBlock x:Name="ConnectionText" Text="局域网 · 等待连接" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
                <Border Grid.Row="1" Margin="12,10,12,6" Padding="2" Background="{StaticResource PanelLightBrush}" CornerRadius="8">
                    <Grid x:Name="TabStrip" SizeChanged="TabStrip_SizeChanged">
                    <Border x:Name="TabIndicator" Background="#31534F" CornerRadius="6" HorizontalAlignment="Left" Width="46" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="TabIndicatorTranslate"/></Border.RenderTransform></Border>
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="TabRecent" Content="全部" IsChecked="True" Style="{StaticResource TabButtonStyle}" Tag="Recent" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabFavorites" Content="收藏" Style="{StaticResource TabButtonStyle}" Tag="Favorites" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabImage" Content="图片" Style="{StaticResource TabButtonStyle}" Tag="Image" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabText" Content="文字" Style="{StaticResource TabButtonStyle}" Tag="Text" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabVideo" Content="视频" Style="{StaticResource TabButtonStyle}" Tag="Video" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabAudio" Content="音频" Style="{StaticResource TabButtonStyle}" Tag="Audio" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabOther" Content="其他" Style="{StaticResource TabButtonStyle}" Tag="Other" Checked="Tab_Checked"/>
                    </UniformGrid>
                    </Grid>
                </Border>
                <!-- 内容区 -->
                <Grid x:Name="ContentArea" Grid.Row="2" Background="{StaticResource PanelBrush}" ClipToBounds="True">
                    <!-- 网格视图（图片/视频/其他文件/最近） -->
                    <ListView x:Name="GridView"
                              Visibility="Visible"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsSource="{Binding}"
                              Padding="0" SelectionMode="Extended" SelectionChanged="MaterialSelectionChanged"
                              Margin="8,2">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="164"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <!-- 文字视图（自动换行卡片） -->
                    <ListView x:Name="TextView"
                              Visibility="Collapsed"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsSource="{Binding}"
                              ItemTemplate="{StaticResource TextCardTemplate}"
                              Padding="0" SelectionMode="Extended" SelectionChanged="MaterialSelectionChanged"
                              Margin="8,2">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <!-- 列表视图（音频） -->
                    <ListView x:Name="ListView"
                              Visibility="Collapsed"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsSource="{Binding}"
                              Padding="0" SelectionMode="Extended" SelectionChanged="MaterialSelectionChanged"
                              Margin="4,2"/>

                    <!-- 空状态提示 -->
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" Text="把素材放在这里"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyDescription" Text="拖入文件，或点击上方「添加文件」"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Opacity="0.9"/>
                    </StackPanel>

                    <!-- 拖入高亮提示 -->
                    <Border x:Name="DropHighlight"
                            Background="#153B82F6"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Margin="4"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock Text="松开添加素材"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="14" FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource PanelLightBrush}" Padding="12,8,12,10">
                    <StackPanel>
                        <TextBlock x:Name="FeedbackText" Text="单击复制 · 拖出使用 · 右键更多" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="更多" Style="{StaticResource ActionButtonStyle}" Padding="8,4" Click="ManageBtn_Click" ToolTip="清空分类与全部清空"/>
                            <Button DockPanel.Dock="Right" Content="收发" Style="{StaticResource ActionButtonStyle}" Padding="8,4" Margin="0,0,6,0" Click="TransfersBtn_Click" ToolTip="查看收发任务"/>
                            <Button DockPanel.Dock="Right" x:Name="UndoBtn" Content="撤回" Style="{StaticResource ActionButtonStyle}" Padding="8,4" Margin="0,0,6,0" Click="UndoBtn_Click" ToolTip="撤回删除 · Ctrl+Z" IsEnabled="False"/>
                            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <!-- 底部拖拽调整高度 -->
                <Thumb x:Name="ResizeThumb"
                       Grid.Row="3"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Bottom"
                       Height="4"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta"
                       Background="Transparent"/>
            </Grid>
        </Border>

        <!-- ============ 触发条 ============ -->
        <Border x:Name="TriggerBar"
                Grid.Column="1"
                Background="{StaticResource TriggerBarBrush}"
                CornerRadius="0,3,3,0"
                Opacity="0.4"
                AllowDrop="True"
                Drop="Window_Drop"
                DragEnter="Window_DragEnter"
                DragOver="Window_DragOver"
                DragLeave="Window_DragLeave"
                MouseEnter="TriggerBar_MouseEnter">
            <Rectangle Width="2" Height="40"
                       Fill="{StaticResource AccentBrush}"
                       Opacity="0.6"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RadiusX="1" RadiusY="1"/>
        </Border>
    </Grid>
</Window>
