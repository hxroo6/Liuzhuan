<Window x:Class="Liuzhuan.Views.TransferWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="收发任务" Width="840" Height="680" MinWidth="620" MinHeight="460" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TransferButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{StaticResource PanelLightBrush}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource BorderBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
            <ToggleButton Foreground="{StaticResource TextBrush}" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource PanelLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0"/><ContentPresenter TextElement.Foreground="{StaticResource TextBrush}" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource PanelLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="130" Padding="4"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup>
        </Grid></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <DockPanel Margin="20" Background="{StaticResource PanelBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="收发任务" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="OverviewText" Text="本机任务记录" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="已发送表示电脑已写出文件；手机保存结果请在手机查看。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,6,0,0"/>
            <TextBlock Text="两端更新后支持断点续传、SHA-256 校验与重启恢复。暂停保留断点；旧版对端仍需从头重传。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="打开接收目录" Style="{StaticResource TransferButtonStyle}" Click="OpenReceived_Click" Margin="0,0,10,0"/>
                <Button Content="文件管理器设置" Style="{StaticResource TransferButtonStyle}" Click="Manager_Click"/>
            </StackPanel>
            <TextBlock x:Name="PolicySummary" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" FontSize="12"/>
            <Expander Header="传输优先级与限速" Margin="0,8,0,0" Foreground="{StaticResource TextBrush}">
                <StackPanel Margin="0,8,0,0">
                    <WrapPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="排队优先" Margin="0,0,0,5"/><ComboBox x:Name="PriorityBox" Width="140" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="传输排队优先级"/></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="电脑发送" Margin="0,0,0,5"/><ComboBox x:Name="SendRateBox" Width="120" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="电脑发送限速"/></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="电脑接收" Margin="0,0,0,5"/><ComboBox x:Name="ReceiveRateBox" Width="120" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="电脑接收限速"/></StackPanel>
                    </WrapPanel>
                    <CheckBox x:Name="AudioYieldBox" Content="音频转发时为麦克风让路（上下行各不超过 1 MiB/s）" Foreground="{StaticResource TextBrush}" Margin="0,2,0,8"/>
                    <TextBlock Text="只调整等待任务和文件数据块，最多同时传输 2 项；控制与回执立即处理。两端同时限速时取较低速度。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                    <Button x:Name="SavePolicyButton" Content="保存并立即生效" Style="{StaticResource TransferButtonStyle}" Click="SavePolicy_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" MaxLength="256" Padding="10,8" FontSize="13" Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource AccentBrush}" TextChanged="Search_Changed" ToolTip="搜索任务名称、方向或状态" AutomationProperties.Name="搜索收发任务"/>
                <TextBlock Text="搜索任务名称、方向或状态" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextDimBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ComboBox x:Name="DirectionBox" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Direction_Changed" AutomationProperties.Name="任务传输方向">
                    <ComboBoxItem Content="全部方向"/><ComboBoxItem Content="接收"/><ComboBoxItem Content="发送"/>
                </ComboBox>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="AllFilter" Content="全部" Tag="All" Style="{StaticResource TransferButtonStyle}" Click="Filter_Click" Margin="0,0,8,6"/>
                <Button x:Name="ActiveFilter" Content="进行中" Tag="Active" Style="{StaticResource TransferButtonStyle}" Click="Filter_Click" Margin="0,0,8,6"/>
                <Button x:Name="AttentionFilter" Content="待处理" Tag="Attention" Style="{StaticResource TransferButtonStyle}" Click="Filter_Click" Margin="0,0,8,6"/>
                <Button x:Name="FinishedFilter" Content="已结束" Tag="Finished" Style="{StaticResource TransferButtonStyle}" Click="Filter_Click" Margin="0,0,8,6"/>
                <TextBlock x:Name="ResultText" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
            </WrapPanel>
        </StackPanel>
        <Grid>
            <TextBlock x:Name="EmptyText" Text="暂无收发任务，传输文件后会显示在这里。" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Background="{StaticResource PanelLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" FontSize="14"/>
                            <TextBlock Text="{Binding Summary}" Margin="0,7,0,0" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="失败"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Done}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelBrush}" BorderThickness="0" Height="4" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDimBrush}" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Text="{Binding SavedPath}" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,7,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{Binding PauseLabel}" Tag="{Binding Id}" Click="Pause_Click" Margin="0,0,8,0">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TransferButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanControl}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="取消" Tag="{Binding Id}" Click="Cancel_Click" Margin="0,0,8,0">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TransferButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanControl}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="打开保存位置" Tag="{Binding SavedPath}" Click="OpenSaved_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TransferButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanOpenFolder}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
