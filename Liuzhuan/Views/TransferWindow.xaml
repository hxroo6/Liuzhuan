<Window x:Class="Liuzhuan.Views.TransferWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="收发任务" Width="520" Height="540" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20" Background="{StaticResource PanelBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="收发任务" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="本次运行记录 · 失败后请在发送端重试" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="已发送表示电脑已写出文件；手机保存结果请在手机查看。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid>
            <TextBlock Text="暂无收发任务，传输文件后会显示在这里。" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ListBox ItemsSource="{Binding}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Background="{StaticResource PanelLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" FontSize="14"/>
                            <TextBlock Text="{Binding Summary}" Margin="0,7,0,0" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="失败"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Done}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelBrush}" BorderThickness="0" Height="4" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDimBrush}" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
