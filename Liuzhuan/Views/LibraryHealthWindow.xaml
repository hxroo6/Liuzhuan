<Window x:Class="Liuzhuan.Views.LibraryHealthWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="素材库与恢复" Width="820" Height="740" MinWidth="650" MinHeight="570" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#132D2D"/><Setter Property="Background" Value="#E5F0EC"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/><Setter Property="Background" Value="{StaticResource PanelLightBrush}"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Pill" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Pill" Property="Background" Value="#29514B"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Pill" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24" Background="{StaticResource PanelBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock Text="素材留得住，也能安全回到之前" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="当前会话始终使用当前素材库。切库或恢复在下次启动时执行，原文件不删除、不覆盖。" TextWrapping="Wrap"/><TextBlock x:Name="PendingText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,7,0,0"/></StackPanel></Border>
        <TabControl Grid.Row="2" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0">
            <TabItem Header="素材库"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="Libraries" Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Library_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12,10"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding Root}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="列出默认库、导入库和最近保留的库。这里只统计索引；文件占用与回收请使用容量管理。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10"/><Button x:Name="SwitchButton" Content="下次启动切换到所选库" HorizontalAlignment="Left" IsEnabled="False" Click="Switch_Click"/></StackPanel>
            </Grid></TabItem>
            <TabItem Header="索引历史"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="保存时最多每5分钟留存一次旧索引，最多10份、合计128 MiB，单份64 MiB。只恢复素材条目和整理信息；原件、设置、身份及收发回执保持现状。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10"/>
                <DockPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="DiffButton" Content="比较变化" DockPanel.Dock="Right" Click="Diff_Click"/><ComboBox x:Name="Versions" DisplayMemberPath="Label" MinHeight="36" Margin="0,0,10,0" SelectionChanged="Version_SelectionChanged" AutomationProperties.Name="当前库索引历史"/></DockPanel>
                <ListBox x:Name="Differences" Grid.Row="2" Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="DifferenceSummary" Text="选择一份历史并比较。当前索引无法读取时，也可从已校验历史恢复；恢复前保留原索引备份。" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/><Button x:Name="RestoreButton" Content="下次启动恢复这份索引" HorizontalAlignment="Left" IsEnabled="False" Click="Restore_Click"/></StackPanel>
            </Grid></TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Margin="0,14,0,0"><ProgressBar x:Name="Busy" Height="4" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="Status" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,9,0,12" MaxHeight="74"/><DockPanel><StackPanel Orientation="Horizontal"><Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"/><Button x:Name="CancelPlanButton" Content="取消启动计划" Click="CancelPlan_Click"/></StackPanel><Button Content="关闭" HorizontalAlignment="Right" Click="Close_Click" Margin="0"/></DockPanel></StackPanel>
    </Grid>
</Window>
