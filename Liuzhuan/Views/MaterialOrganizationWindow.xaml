<Window x:Class="Liuzhuan.Views.MaterialOrganizationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="整理素材" Width="560" Height="650" MinWidth="480" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}" FontSize="13" PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="MetadataInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,18,0"/></Style>
    </Window.Resources>
    <Grid Margin="24" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="给素材一个好找的位置" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/><TextBlock x:Name="BatchHint" Text="批量修改时，只应用勾选的字段；其他信息保留。" Foreground="{StaticResource WarmBrush}" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10"><StackPanel>
                    <CheckBox x:Name="GroupApply" Content="设置分组"/>
                    <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="已有分组 ▾" Click="ChooseGroup_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,8" Margin="8,0,0,0"/><TextBox x:Name="GroupInput" Style="{StaticResource MetadataInput}" IsEnabled="{Binding IsChecked, ElementName=GroupApply}" AutomationProperties.Name="素材分组名称"/></DockPanel>
                    <TextBlock Text="输入新名称即可创建分组，留空表示未分组；最多 48 个字符。" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel></Border>
                <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10"><StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Content="已有标签 ▾" Click="ChooseTag_Click" Style="{StaticResource IconButtonStyle}" Padding="5,0"/><CheckBox x:Name="TagsApply" Content="修改标签"/></DockPanel>
                    <TextBox x:Name="TagsInput" Style="{StaticResource MetadataInput}" Margin="0,10,0,10" IsEnabled="{Binding IsChecked, ElementName=TagsApply}" AutomationProperties.Name="素材标签"/>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=TagsApply}"><RadioButton x:Name="TagsAdd" Content="追加" GroupName="TagMode"/><RadioButton x:Name="TagsReplace" Content="替换" GroupName="TagMode"/><RadioButton x:Name="TagsRemove" Content="移除" GroupName="TagMode"/></StackPanel>
                    <TextBlock Text="用逗号或分号分隔。每条素材最多 20 个标签，每个最多 32 个字符；选择「替换」并留空可清除标签。" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel></Border>
                <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="16"><StackPanel>
                    <CheckBox x:Name="NoteApply" Content="编辑备注"/>
                    <TextBox x:Name="NoteInput" Style="{StaticResource MetadataInput}" Height="116" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" IsEnabled="{Binding IsChecked, ElementName=NoteApply}" AutomationProperties.Name="素材备注"/>
                    <TextBlock Text="备注也能搜索；最多 4000 个字符，留空可清除。" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="Status" Text="整理信息随素材保存和迁移，原文件保持不变。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12" MaxHeight="65"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Style="{StaticResource ActionButtonStyle}" Padding="18,9" Margin="0,0,8,0"/><Button Content="保存整理信息" Click="Save_Click" Style="{StaticResource ActionButtonStyle}" Padding="18,9" ToolTip="保存 · Ctrl+Enter"/></StackPanel>
        </StackPanel>
    </Grid>
</Window>
