<Window x:Class="Liuzhuan.Views.FileManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="文件管理器" Width="640" Height="420" MinWidth="560" MinHeight="420" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources><Style x:Key="ManagerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/></Style></Window.Resources>
    <StackPanel Margin="24" Background="{StaticResource PanelBrush}">
        <TextBlock Text="打开保存位置" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="默认使用 Windows 资源管理器，也可选择自己的文件管理器。" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,18" TextWrapping="Wrap"/>
        <TextBlock Text="文件管理器 EXE（留空使用系统默认）" Margin="0,0,0,6"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="选择…" Style="{StaticResource ManagerButtonStyle}" Click="Browse_Click" Margin="10,0,0,0"/><TextBox x:Name="ExecutableBox" Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}" Padding="8"/></DockPanel>
        <TextBlock Text="启动参数模板" Margin="0,18,0,6"/>
        <TextBox x:Name="ArgumentsBox" Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}" Padding="8"/>
        <TextBlock Text="{}{folder} 代表目录；例如 Total Commander：/O /T /L={folder}。包含空格的固定参数用双引号包裹，目录由程序安全传参。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,12" FontSize="12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="恢复系统默认" Style="{StaticResource ManagerButtonStyle}" Click="Reset_Click" Margin="0,0,10,0"/>
            <Button Content="保存" Style="{StaticResource ManagerButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
