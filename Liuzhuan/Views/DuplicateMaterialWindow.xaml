<Window x:Class="Liuzhuan.Views.DuplicateMaterialWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同内容重复素材" Width="960" Height="680" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{StaticResource PanelLightBrush}" Padding="12,8" CornerRadius="7,7,0,0" Margin="0,0,3,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Tab" Property="Background" Value="#294640"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Margin="0,2"><ContentPresenter/></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#233B3D"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#294640"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="找到改名、换路径后的相同文件" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="先比较大小，再读取候选文件的 SHA-256。只检查本次素材范围，不自动扫描、不移除索引、不删除文件。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,14"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12"><WrapPanel>
            <Button x:Name="StartButton" Content="开始检查" Click="Start_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="取消检查" Click="Cancel_Click" IsEnabled="False" Padding="14,7"/>
        </WrapPanel><TextBlock x:Name="SummaryText" Text="尚未读取文件。" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.42*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.58*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelLightBrush}" CornerRadius="10" Padding="8"><ListBox x:Name="GroupsList" SelectionChanged="Group_Changed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox></Border>
            <TabControl Grid.Column="2" Background="{StaticResource PanelLightBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                <TabItem x:Name="FilesTab" Header="同内容来源"><ListBox x:Name="FilesList" Background="{StaticResource PanelLightBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0"/><Button Content="打开所在位置" Tag="{Binding Path}" Click="OpenLocation_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox></TabItem>
                <TabItem x:Name="IssuesTab" Header="未完成检查"><ListBox x:Name="IssuesList" Background="{StaticResource PanelLightBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource WarmBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox></TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,14"><ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Text="点击开始后才会读取文件；同大小、同名或旧基线相同均不足以判定重复。" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="结果仅代表检查时读取的字节。逻辑重复量按不同路径计算，不等于可释放磁盘空间；硬链接、压缩和外部原件可能共享实际空间。" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <Button Grid.Row="4" Content="关闭" Click="Close_Click" HorizontalAlignment="Right" Padding="18,7"/>
    </Grid>
</Window>
