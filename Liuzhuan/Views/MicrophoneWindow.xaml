<Window x:Class="Liuzhuan.Views.MicrophoneWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="手机麦克风" Width="780" Height="840" MinWidth="640" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}" FontSize="14">
    <Window.Resources>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#132D2D"/><Setter Property="Background" Value="#E5F0EC"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    </Window.Resources>
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelBrush}">
        <StackPanel Margin="26">
            <TextBlock Text="把手机变成电脑麦克风" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="局域网实验功能 · 明文音频 · 不保存录音" Margin="0,8,0,22" Foreground="{StaticResource TextDimBrush}"/>
            <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="HealthCheckButton" DockPanel.Dock="Right" Content="重新体检" Click="HealthCheck_Click" Style="{StaticResource ActionButtonStyle}" Padding="12,7" Margin="12,0,0,0"/>
                        <TextBlock Text="先分清三路声音，外放与听写互不干扰" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="RouteSummary" Text="打开窗口后读取本机设置，不开启录音或修改默认设备。" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                            <StackPanel><TextBlock Text="① 电脑外放" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="实体扬声器 / 耳机" Margin="0,7,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PlaybackRouteText" Text="等待体检" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="3,0,3,0">
                            <StackPanel><TextBlock Text="② 流转写入" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="虚拟播放端：CABLE Input" Margin="0,7,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="OutputRouteText" Text="等待体检" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                            <StackPanel><TextBlock Text="③ 听写读取" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="虚拟录音端：CABLE Output" Margin="0,7,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RecordingRouteText" Text="等待体检" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ItemsControl x:Name="RouteFindings" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,9" Margin="0,5,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource WarmBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PlaybackSettingsButton" Content="打开播放设备 · 修复外放" Click="PlaybackSettings_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,8" Margin="0,0,8,8"/>
                        <Button x:Name="RecordingSettingsButton" Content="打开录音设备 · 检查输入" Click="RecordingSettings_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,8" Margin="0,0,8,8"/>
                        <Button x:Name="SoundSettingsButton" Content="Windows 声音设置" Click="SoundSettings_Click" Style="{StaticResource ActionButtonStyle}" Padding="10,8" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="播放页：实体扬声器/耳机设为默认设备与默认通信设备；录音页：仅当听写跟随系统输入时，才将 CABLE Output 设为默认。无需开启“侦听此设备”。流转只提供入口，由你确认更改。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                    <TextBlock x:Name="RouteCheckTime" Text="体检只核对配置，不证明虚拟线连通或听写识别成功。" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="可用配置保护" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfileSummary" Text="正在读取本机保护档案…" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,6"/>
                    <TextBlock x:Name="ProfileSavedTime" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                    <TextBlock Text="转发确实收到声音并被虚拟播放端读取后，自动记住流转设备。外放和听写均正常时，再确认保存完整配置。发现异常只提醒，不会自动切换设备、调音量或开启麦克风。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,8,0,0"/>
                    <ItemsControl x:Name="ProfileFindings" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,9" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SaveGoodProfileButton" Content="外放和听写正常 · 保存配置" Click="SaveGoodProfile_Click" Style="{StaticResource ActionButtonStyle}" Padding="12,8" Margin="0,0,8,8"/>
                        <Button x:Name="RestoreGoodProfileButton" Content="恢复流转设备选择" Click="RestoreGoodProfile_Click" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Padding="12,8" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="恢复会结束当前音频服务，仅还原流转所选设备。Windows 默认播放、录音和音量只显示旧值供核对；请通过上方系统声音入口调整，之后主动开启服务。不保存录音或识别文字。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                    <TextBlock x:Name="ProfileActionText" TextWrapping="Wrap" Foreground="{StaticResource WarmBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="1. 选择虚拟音频设备" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="流转写入虚拟播放端（例如 CABLE Input）；Codex 选择对应录音端（例如 CABLE Output）。请勿选择扬声器，避免外放。" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12">
                        <Run Text="驱动需另行安装，不包含在流转中。"/><LineBreak/>
                        <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="DriverLink_RequestNavigate" Foreground="{StaticResource AccentBrush}">VB-CABLE 官网下载</Hyperlink>
                        <Run Text=" · "/><Hyperlink NavigateUri="https://vb-audio.com/Services/licensing.htm" RequestNavigate="DriverLink_RequestNavigate" Foreground="{StaticResource AccentBrush}">独立许可说明</Hyperlink>
                        <LineBreak/><Run Text="VB-CABLE 为 Donationware；职业或公司用途应按官方条款购买许可。"/>
                    </TextBlock>
                    <TextBlock x:Name="DeviceHint" TextWrapping="Wrap" Foreground="{StaticResource WarmBrush}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="DiagnosticChoice" Content="仅诊断收音（不输出到虚拟设备，Codex 暂不可用）" Margin="0,0,0,12" Checked="DeviceMode_Changed" Unchecked="DeviceMode_Changed"/>
                    <TextBlock Text="流转的虚拟播放端（不是系统外放设备）" Margin="0,0,0,6"/>
                    <ComboBox x:Name="OutputChoice" DisplayMemberPath="Name" MinHeight="36" SelectionChanged="DeviceChoice_Changed"/>
                    <TextBlock Text="对应的虚拟录音端（用于观察录音会话）" Margin="0,12,0,6"/>
                    <ComboBox x:Name="CaptureChoice" DisplayMemberPath="Name" MinHeight="36" SelectionChanged="DeviceChoice_Changed"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click" Style="{StaticResource ActionButtonStyle}" Padding="12,8" Margin="0,0,10,0"/>
                        <Button x:Name="EnableButton" Content="开启音频服务" Click="Enable_Click" Style="{StaticResource ActionButtonStyle}" Padding="12,8" Margin="0,0,10,0"/>
                        <Button x:Name="DisableButton" Content="关闭服务" Click="Disable_Click" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Padding="12,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="2. 扫一个码，连接素材与麦克风" FontSize="17" FontWeight="SemiBold"/>
                    <ComboBox x:Name="NetworkChoice" DisplayMemberPath="Label" MinHeight="34" Margin="0,12,0,8" SelectionChanged="Network_Changed"/>
                    <Button x:Name="QrButton" Content="显示流转连接二维码" Click="Qr_Click" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Padding="12,8" HorizontalAlignment="Left"/>
                    <Image x:Name="QrImage" Width="220" Height="220" Margin="0,12,0,0" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="PairingText" Text="手机连接页扫码一次，素材握手后自动接通麦克风。首次允许系统录音权限；已连接时点左上音波图可直接重开，无需再扫。" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="3. 转发到 Codex 原听写" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="音频服务已关闭" TextWrapping="Wrap" Margin="0,12,0,8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RecoveryText" TextWrapping="Wrap" Foreground="{StaticResource WarmBrush}" Margin="0,0,0,10"/>
                    <Button x:Name="RetryAudioButton" Content="按原设备重试 · 不切换扬声器" Click="RetryAudio_Click" Style="{StaticResource ActionButtonStyle}" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StatsText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                    <ProgressBar x:Name="ReceiveLevel" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelBrush}" Margin="0,12,0,6"/>
                    <TextBlock x:Name="LevelText" Text="等待手机音频" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock x:Name="OutputText" TextWrapping="Wrap" Foreground="{StaticResource WarmBrush}" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="StartButton" Content="开始转发" Click="Start_Click" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Padding="12,8" Margin="0,0,10,8"/>
                        <Button x:Name="StopButton" Content="停止转发" Click="Stop_Click" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Padding="12,8" Margin="0,0,10,8"/>
                        <Button x:Name="EndButton" Content="结束手机会话" Click="End_Click" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Padding="12,8" Margin="0,0,10,8"/>
                    </WrapPanel>
                    <TextBlock Text="扫码握手后会自动转发，可直接点 Codex 听写。安静时只留心跳，说话后恢复。手动停止后可点“开始转发”；若在手机暂停，先在手机允许再次请求。停止转发仍会采音，“结束手机会话”才释放麦克风。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                    <Expander Header="链路诊断 · 不含录音与设备标识" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock x:Name="DiagnosticText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                            <Button x:Name="CopyDiagnosticsButton" Content="复制脱敏诊断" Click="CopyDiagnostics_Click" Style="{StaticResource ActionButtonStyle}" Padding="12,8" HorizontalAlignment="Left" Margin="0,10,0,6"/>
                            <TextBlock x:Name="DiagnosticHint" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Expander>
                    <CheckBox x:Name="ObserveChoice" Content="观察 Codex 录音会话（实验，不自动开麦）" Margin="0,16,0,6" Checked="Observe_Changed" Unchecked="Observe_Changed" IsEnabled="False"/>
                    <TextBlock x:Name="ObserverText" Text="自动跟随需先验证当前 Codex 的录音会话行为。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                    <Button x:Name="CalibrateButton" Content="校准原听写：开启一次后结束" Click="Calibrate_Click" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Padding="12,8" HorizontalAlignment="Left" Margin="0,12,0,8"/>
                    <CheckBox x:Name="AutomaticChoice" Content="自动跟随 Codex 录音（实验，仅限本次手机会话）" Checked="Automatic_Changed" Unchecked="Automatic_Changed" IsEnabled="False" Margin="0,4,0,8"/>
                    <TextBlock x:Name="FollowText" TextWrapping="Wrap" Foreground="{StaticResource WarmBrush}"/>
                    <TextBlock Text="仅支持可验证的官方 Codex 录音会话。先校准，再启用；不监听鼠标点击，不读取识别内容。手动停止、手机暂停或连接变化会关闭自动跟随。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource WarmBrush}" Margin="0,14,0,0"/>
            <TextBlock Text="仅用于同一局域网或手机热点，音频端口 8902。关闭本窗口不会关闭音频服务；请用“关闭服务”结束。未安装虚拟音频驱动时需先自行安装。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,18,0,0"/>
            <Button Content="返回素材栏" Click="Close_Click" Style="{StaticResource ActionButtonStyle}" Padding="14,9" HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
