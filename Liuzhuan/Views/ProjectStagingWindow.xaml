<Window x:Class="Liuzhuan.Views.ProjectStagingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目暂存管理" Width="820" Height="700" MinWidth="640" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UIFont}">
    <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="Padding" Value="13,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
    <Grid Margin="24" Background="{StaticResource PanelBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock Text="看清项目暂存，再决定是否回收" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="项目包预览准备的原件会保留。这里显式扫描、保护素材与撤回／续传引用，将未引用原件移入独立回收区；随时可恢复最近一批。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelLightBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="Summary" Text="点击“扫描暂存”后显示原件的逻辑占用；打开窗口不会扫描素材。" TextWrapping="Wrap"/><TextBlock x:Name="Warnings" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/></StackPanel></Border>
        <ListBox x:Name="Files" Grid.Row="2" SelectionMode="Extended" Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Selection_Changed">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12,9"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding Relative}" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,14,0,0"><ProgressBar x:Name="Busy" Height="4" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="仅列出未引用的候选原件。没有自动清理，不删除项目绑定，不覆盖已有文件。" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,9,0,12" MaxHeight="72"/>
            <WrapPanel><Button x:Name="ScanButton" Content="扫描暂存" Click="Scan_Click"/><Button x:Name="SelectButton" Content="选择前200项" IsEnabled="False" Click="Select_Click"/><Button x:Name="RecycleButton" Content="移入项目回收区" IsEnabled="False" Click="Recycle_Click"/><Button x:Name="RestoreButton" Content="恢复最近一批" Click="Restore_Click"/><Button Content="关闭" Click="Close_Click" Margin="0"/></WrapPanel>
        </StackPanel>
    </Grid>
</Window>
